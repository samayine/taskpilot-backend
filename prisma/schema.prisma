// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users        User[]
  teams        Team[]
  activityLogs ActivityLog[]
  departments  Department[]
  projects     Project[]
  chatChannels ChatChannel[]
  documents    Document[]
}

model User {
  id                 String   @id @default(uuid())
  fullName           String
  email              String   @unique
  password           String
  role               Role
  isBlocked          Boolean  @default(false)
  status             String   @default("Active")
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  teams              Team[]
  teamMembers        TeamMember[]
  createdTasks       Task[]             @relation("CreatedTasks")
  assignedTasks      Task[]             @relation("AssignedTasks")
  notifications      Notification[]
  taskHistoryChanges TaskHistory[]      @relation("TaskHistoryChanges")
  activityLogs       ActivityLog[]
  comments           Comment[]
  headOfDepartments  Department[]       @relation("DepartmentHead")
  createdProjects    Project[]          @relation("ProjectCreator")
  chatMemberships    ChatChannelMember[]
  chatMessages       ChatMessage[]
  documents          Document[]         @relation("DocumentUploader")

  @@index([companyId])
}

enum Role {
  CEO
  ASSISTANT
  DEPARTMENT_HEAD
  TEAM_LEAD
  EMPLOYEE
}

// ──────────────────────────────────────────────
// Departments
// ──────────────────────────────────────────────

model Department {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // The department head
  headId String?
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id])

  teams              Team[]
  projectDepartments ProjectDepartment[]

  @@unique([companyId, name]) // No duplicate department names within a company
  @@index([companyId])
}

// ──────────────────────────────────────────────
// Teams
// ──────────────────────────────────────────────

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Optional link to a department (replaces old `department: String?`)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  teamLeadId String
  teamLead   User         @relation(fields: [teamLeadId], references: [id])
  members    TeamMember[]
  tasks      Task[]

  @@index([companyId])
  @@index([teamLeadId])
  @@index([departmentId])
}

model TeamMember {
  id       String   @id @default(uuid())
  userId   String
  teamId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

// ──────────────────────────────────────────────
// Projects (Cross-Department)
// ──────────────────────────────────────────────

model Project {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  creatorId String
  creator   User   @relation("ProjectCreator", fields: [creatorId], references: [id])

  departments ProjectDepartment[]
  tasks       Task[]
  channels    ChatChannel[]
  documents   Document[]

  @@index([companyId])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model ProjectDepartment {
  id           String   @id @default(uuid())
  projectId    String
  departmentId String
  joinedAt     DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([projectId, departmentId])
}

// ──────────────────────────────────────────────
// Task Management
// ──────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  REVIEW
  COMPLETED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The team this task belongs to
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  // The team lead who created the task
  creatorId String
  creator   User   @relation("CreatedTasks", fields: [creatorId], references: [id])

  // The employee assigned to this task
  assigneeId String
  assignee   User   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  // Optional project link (for cross-department projects)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // Which department this task is tagged for (in cross-dept projects)
  departmentTag String?

  notifications Notification[]
  history       TaskHistory[]
  comments      Comment[]

  @@index([teamId])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([projectId])
}

// ──────────────────────────────────────────────
// Task Comments
// ──────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

// ──────────────────────────────────────────────
// Task History (Audit Trail)
// ──────────────────────────────────────────────

enum TaskAction {
  CREATED
  STATUS_CHANGED
  REVIEWED
  REASSIGNED
}

model TaskHistory {
  id        String     @id @default(uuid())
  action    TaskAction
  oldValue  Json?
  newValue  Json?
  createdAt DateTime   @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  changedById String
  changedBy   User   @relation("TaskHistoryChanges", fields: [changedById], references: [id])

  @@index([taskId])
}

// ──────────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  TASK_STARTED
  TASK_SUBMITTED
  TASK_IN_REVIEW
  TASK_APPROVED
  TASK_REJECTED
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Who receives this notification
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The task that triggered this notification (optional)
  taskId String?
  task   Task?  @relation(fields: [taskId], references: [id])
}

// ──────────────────────────────────────────────
// Activity Log (System-wide)
// ──────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  // Who performed the action
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  // Company scope for multi-tenancy
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([userId])
}

// ──────────────────────────────────────────────
// Chat System
// ──────────────────────────────────────────────

model ChatChannel {
  id        String      @id @default(uuid())
  name      String
  type      ChannelType @default(PROJECT)
  createdAt DateTime    @default(now())

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  messages ChatMessage[]
  members  ChatChannelMember[]

  @@index([projectId])
  @@index([companyId])
}

enum ChannelType {
  PROJECT
  DEPARTMENT
  DIRECT
  ANNOUNCEMENT
}

model ChatChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  channelId String
  channel   ChatChannel @relation(fields: [channelId], references: [id])

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  documents DocumentShare[]

  @@index([channelId])
}

// ──────────────────────────────────────────────
// Document Management
// ──────────────────────────────────────────────

model Document {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String   // Cloud storage URL (S3, Cloudinary, etc.)
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  uploaderId String
  uploader   User   @relation("DocumentUploader", fields: [uploaderId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Visibility control
  visibility DocumentVisibility @default(ALL)

  shares      DocumentShare[]
  accessRules DocumentAccessRule[]

  @@index([projectId])
  @@index([companyId])
}

enum DocumentVisibility {
  ALL              // Everyone in the project/team can see
  DEPARTMENT_ONLY  // Only the uploader's department
  SPECIFIC         // Only specific users/teams (defined in DocumentAccessRule)
}

model DocumentAccessRule {
  id         String @id @default(uuid())
  documentId String

  document Document @relation(fields: [documentId], references: [id])

  // Grant access to a specific user, team, or department
  userId       String?
  teamId       String?
  departmentId String?

  @@index([documentId])
}

model DocumentShare {
  id        String @id @default(uuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id])

  documentId String
  document   Document @relation(fields: [documentId], references: [id])

  @@index([messageId])
}
