// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users User[]
  teams Team[]
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      Role
  isBlocked Boolean  @default(false)
  status    String   @default("Active")
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  teams         Team[]
  teamMembers   TeamMember[]
  createdTasks   Task[]       @relation("CreatedTasks")
  assignedTasks  Task[]       @relation("AssignedTasks")
  notifications  Notification[]
  taskHistoryChanges TaskHistory[] @relation("TaskHistoryChanges")
  activityLogs   ActivityLog[]
}

enum Role {
  CEO
  TEAM_LEAD
  EMPLOYEE
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  teamLeadId String
  teamLead   User         @relation(fields: [teamLeadId], references: [id])
  members    TeamMember[]
  tasks      Task[]
}

model TeamMember {
  id       String   @id @default(uuid())
  userId   String
  teamId   String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

// ──────────────────────────────────────────────
// Task Management
// ──────────────────────────────────────────────

enum TaskStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  REVIEW
  COMPLETED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // The team this task belongs to
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  // The team lead who created the task
  creatorId String
  creator   User   @relation("CreatedTasks", fields: [creatorId], references: [id])

  // The employee assigned to this task
  assigneeId String
  assignee   User   @relation("AssignedTasks", fields: [assigneeId], references: [id])

  notifications Notification[]
  history       TaskHistory[]
}

// ──────────────────────────────────────────────
// Task History (Audit Trail)
// ──────────────────────────────────────────────

enum TaskAction {
  CREATED
  STATUS_CHANGED
  REVIEWED
  REASSIGNED
}

model TaskHistory {
  id        String     @id @default(uuid())
  action    TaskAction
  oldValue  Json?
  newValue  Json?
  createdAt DateTime   @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  changedById String
  changedBy   User   @relation("TaskHistoryChanges", fields: [changedById], references: [id])
}

// ──────────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────────

enum NotificationType {
  TASK_ASSIGNED
  TASK_STARTED
  TASK_SUBMITTED
  TASK_IN_REVIEW
  TASK_APPROVED
  TASK_REJECTED
}

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Who receives this notification
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The task that triggered this notification (optional)
  taskId String?
  task   Task?  @relation(fields: [taskId], references: [id])
}

// ──────────────────────────────────────────────
// Activity Log (System-wide)
// ──────────────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  // Who performed the action
  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  // Company scope for multi-tenancy
  companyId String
}
