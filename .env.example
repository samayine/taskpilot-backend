# copy this file  and fill in your own database credentials!

DATABASE_URL="postgresql://[USER]:[PASSWORD]@127.0.0.1:5432/taskpilot?sslmode=disable"
PORT=3000
JWT_SECRET="replace-with-a-local-secret"
CORS_ORIGIN="*"  # In production: "https://your-frontend.com"

# Frontend base URL — used to build the password reset link in emails
FRONTEND_URL="http://localhost:3000"

# Email (Gmail SMTP) — required for self-service password reset.
# Gmail needs an App Password (enable 2FA, then create one at
# https://myaccount.google.com/apppasswords). Your normal password will NOT work.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587                       # 587 = STARTTLS, 465 = implicit TLS
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="TaskPilot <your-gmail@gmail.com>"
