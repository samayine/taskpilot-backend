# copy this file  and fill in your own database credentials!

DATABASE_URL="postgresql://[USER]:[PASSWORD]@127.0.0.1:5432/taskpilot?sslmode=disable"
PORT=3000
JWT_SECRET="replace-with-a-local-secret"
CORS_ORIGIN="*"  # In production: "https://your-frontend.com"

# Frontend base URL — used to build the password reset link in emails
FRONTEND_URL="http://localhost:3000"

# Email (cPanel SMTP via Nodemailer) — required for onboarding & password reset.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465                       # 465 = implicit SSL/TLS, 587 = STARTTLS
SMTP_SECURE=true                    # true for port 465, false for 587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-mailbox-password
MAIL_FROM="TaskPilot <you@yourdomain.com>"
