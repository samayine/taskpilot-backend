# copy this file  and fill in your own database credentials!

DATABASE_URL="postgresql://[USER]:[PASSWORD]@127.0.0.1:5432/taskpilot?sslmode=disable"
PORT=3000
JWT_SECRET="replace-with-a-local-secret"
CORS_ORIGIN="*"  # In production: "https://your-frontend.com"

# Frontend base URL — used to build the password reset link in emails
FRONTEND_URL="http://localhost:3000"

# Email — Resend (https://resend.com). Create a free account, grab an API key
# from the dashboard, and paste it below.
# MAIL_FROM must be an address on a domain you have verified in Resend.
# For quick local testing you can use: TaskPilot <onboarding@resend.dev>
RESEND_API_KEY="re_your_api_key_here"
MAIL_FROM="TaskPilot <onboarding@resend.dev>"
